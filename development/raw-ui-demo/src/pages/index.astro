---
import RawLayout from '../layouts/RawLayout.astro';

const checkpoints = [
  ['Website Overview','/website-overview','Ready','North-star summary, health, issues, opportunities'],
  ['Crawl runs','/crawl','Ready','Coverage, partial/failure, pipeline diagnostics'],
  ['Issues','/issues','Ready','Severity, priority, lifecycle, evidence inventory'],
  ['Page detail','/page-detail','Ready','Snapshot, indexability, content, CWV, search demand'],
  ['Search performance','/search','Ready','Query demand, landing pages, opportunity evidence'],
  ['AI visibility','/geo','Ready','Mentions, citations, source gap, prompt samples'],
  ['Tasks & validation','/tasks','Ready','Remediation queue and validation loop'],
];
---
<RawLayout title="Visual validation workspace" eyebrow="SEO GEO Audit Platform" description="Use populated screens to challenge BA/DA/UIUX assumptions before production implementation." trace="DEV-RAW-002 · visual feedback may reopen UI/UX decisions through change control">
  <section class="grid kpis">
    <article class="card kpi"><div class="kpi-label">Demo screens</div><div class="kpi-value">7</div><div class="kpi-foot">All use realistic contract-shaped dummy data</div></article>
    <article class="card kpi"><div class="kpi-label">Production code</div><div class="kpi-value" style="font-size:20px">Not started</div><div class="kpi-foot">Astro sandbox remains isolated</div></article>
    <article class="card kpi"><div class="kpi-label">Primary review</div><div class="kpi-value" style="font-size:20px">Hierarchy</div><div class="kpi-foot">Density · action clarity · state clarity</div></article>
    <article class="card kpi"><div class="kpi-label">Change rule</div><div class="kpi-value" style="font-size:20px">Trace first</div><div class="kpi-foot">Visual issue vs semantic issue</div></article>
  </section>

  <section class="grid two" style="margin-top:14px">
    <article class="card">
      <div class="card-header"><div><h2>Screen checkpoints</h2><p>Open each screen and judge it as an operational product, not a document mock.</p></div></div>
      <div class="card-body list">
        {checkpoints.map(([name,href,status,note]) => (
          <a class="list-item" href={href}>
            <div><div class="list-title">{name}</div><div class="list-meta">{note}</div></div>
            <span class="badge success">{status} →</span>
          </a>
        ))}
      </div>
    </article>

    <div class="stack">
      <article class="card pad">
        <div class="kpi-label">What this prototype must reveal</div>
        <div class="list" style="margin-top:8px">
          <div class="list-item"><div><div class="list-title">Can I see what needs attention in 5–10 seconds?</div><div class="list-meta">No decorative score should hide real issues or opportunity evidence.</div></div></div>
          <div class="list-item"><div><div class="list-title">Can I move from summary → evidence → action?</div><div class="list-meta">Overview → Issue/Page → Task → Validation should feel continuous.</div></div></div>
          <div class="list-item"><div><div class="list-title">Are incomplete states explicit?</div><div class="list-meta">UNKNOWN / PARTIAL / FAILED / stale must never look like zero or success.</div></div></div>
        </div>
      </article>
      <article class="card pad">
        <div class="callout warning"><strong>UI/UX baseline is not sacred.</strong> If a populated layout exposes bad hierarchy, missing data, unclear state or an impossible flow, log the finding and amend the UI/UX spec. The prototype exists specifically to catch those problems before Next.js implementation.</div>
      </article>
    </div>
  </section>
</RawLayout>
