---
const items = [
  { href: '/', label: 'Demo Index' },
  { href: '/website-overview', label: 'Website Overview' },
  { href: '/crawl', label: 'Crawl' },
  { href: '/issues', label: 'Issues' },
  { href: '/page-detail', label: 'Page Detail' },
  { href: '/search', label: 'Search' },
  { href: '/geo', label: 'GEO / AI' },
  { href: '/tasks', label: 'Tasks' },
];
---
